# ---------------------------------------------------------------------------
# Copy to .env and fill in. `make env` does this and generates a password.
# Everything here is read by docker compose for interpolation.
# ---------------------------------------------------------------------------

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=ccse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ccse

# --- Images ----------------------------------------------------------------
# Must match the GHCR path used by .github/workflows/ci.yml
IMAGE_PREFIX=ghcr.io/railmedia/ccse-prep
TAG=latest

# --- Edge (Traefik) --------------------------------------------------------
PUBLIC_HOST=ccse-prep.tudorache.me
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le

# --- Application -----------------------------------------------------------
CCSE_ENV=dev
CCSE_LOG_LEVEL=INFO

# --- Local ports (dev only; uncomment to override) -------------------------
# API_PORT=8000
# WEB_PORT=4321
# POSTGRES_PORT=5432

# --- Model providers (Sprint 3+) ------------------------------------------
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Local inference (Ollama) is opt-in and developer-machine only.
LOCAL_LLM_ENABLED=false

# Set to true behind HTTPS so the anonymous cookie is Secure.
CCSE_COOKIE_SECURE=false

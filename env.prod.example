# Production environment template.
#
# Copy to <DEPLOY_PATH>/.env on the server (sibling of infra/), fill in, and
# never commit it. `infra/deploy.sh` rewrites TAG on every deploy.
# `infra/bootstrap.sh` reads MANUAL_URL / MANUAL_YEAR from here.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=ccse
POSTGRES_PASSWORD=replace-with-a-32-char-hex-string
POSTGRES_DB=ccse

# --- Edge (existing Traefik) ----------------------------------------------
PUBLIC_HOST=ccse-prep.tudorache.me
# Entrypoint that terminates TLS.
TRAEFIK_ENTRYPOINT=websecure
# Entrypoint used only for the HTTP->HTTPS redirect router.
TRAEFIK_HTTP_ENTRYPOINT=web
# Must match a certificatesResolvers key in the Traefik config.
TRAEFIK_CERTRESOLVER=le

# --- Images ---------------------------------------------------------------
# CI derives this from github.repository; it must match what CI pushes.
IMAGE_PREFIX=ghcr.io/railmedia/ccse-prep
TAG=latest

# --- Application ----------------------------------------------------------
CCSE_ENV=prod
CCSE_LOG_LEVEL=INFO
# Required behind HTTPS: keeps the anonymous session cookie Secure.
CCSE_COOKIE_SECURE=true

# --- Model providers (optional) -------------------------------------------
# Empty keys fall back to deterministic extractive explanations.
MISTRAL_API_KEY=
OPENAI_API_KEY=
# Local inference is developer-machine only; leave disabled in production.
LOCAL_LLM_ENABLED=false

# --- Data bootstrap (infra/bootstrap.sh) ----------------------------------
MANUAL_URL=https://cervantes.org/sites/public/produccion/files/2026-10/manual-preparacion-prueba-ccse-2026.pdf
MANUAL_YEAR=2026
